# ==============================================================================
# ETAPA 1: BUILDER (Descarga de Miniconda y creación de entornos aislados)
# ==============================================================================
FROM debian:bookworm-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    CONDA_DIR=/opt/conda

SHELL ["/bin/bash", "-c"]

# Instalar utilidades temporales necesarias solo para descargar e instalar Conda
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    bzip2 \
    && rm -rf /var/lib/apt/lists/*

# Instalar Miniconda3 (v26.9.4-1)
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-py312_26.9.4-1-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p $CONDA_DIR && \
    rm /tmp/miniconda.sh

ENV PATH=$CONDA_DIR/bin:$PATH

# Configurar conda para evitar Terms of service y aceptar licencias automáticamente
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main \
    && conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r


# Configurar canales en orden estricto para Bioconda
RUN conda config --add channels defaults && \
    conda config --add channels bioconda && \
    conda config --add channels conda-forge && \
    conda config --set channel_priority strict 
   


# Entorno principal (base): JupyterLab, kernel de BASH y herramientas modernas
RUN conda install -y -n base \
    jupyterlab \
    bash_kernel \
    samtools=1.25 \
    bcftools=1.25 \
    bowtie2=2.5.5 \
    bedtools=2.31.1 && \
    conda clean -afy

# Entorno aislado (rna_legacy): Herramientas heredadas sin conflictos de Python/Boost
RUN conda create -y -n rna_legacy \
    tophat=2.1.1 \
    cufflinks=2.2.1 && \
    conda clean -afy

# Eliminar archivos estáticos y bytecode innecesario para reducir tamaño antes de copiar
RUN find $CONDA_DIR -follow -type f -name '*.a' -delete && \
    find $CONDA_DIR -follow -type f -name '*.pyc' -delete && \
    find $CONDA_DIR -follow -type f -name '*.js.map' -delete


# ==============================================================================
# ETAPA 2: RUNTIME (Imagen final minimalista con BASH y usuario no-root)
# ==============================================================================
FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    CONDA_DIR=/opt/conda \
    NB_USER=bioinfo \
    NB_UID=1000 \
    HOME=/home/bioinfo

ENV PATH=$CONDA_DIR/bin:$CONDA_DIR/envs/rna_legacy/bin:$PATH

SHELL ["/bin/bash", "-c"]

# Instalar únicamente bibliotecas dinámicas de ejecución y BASH (sin wget ni bzip2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    wget \
    procps \
    libgomp1 \
    zlib1g \
    libncurses6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario no-root y directorio de trabajo
RUN useradd -m -s /bin/bash -N -u $NB_UID $NB_USER && \
    mkdir -p $HOME/work && \
    chown -R $NB_USER:users $HOME

# Copiar el árbol completo de Conda desde el builder asignando permisos directamente al usuario
COPY --from=builder --chown=$NB_USER:users $CONDA_DIR $CONDA_DIR

USER $NB_USER
WORKDIR $HOME/work

# Inicializar Conda en ~/.bashrc y registrar el kernel de BASH para JupyterLab
RUN conda init bash && \
    python -m bash_kernel.install --user

EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--ServerApp.terminado_settings={'shell_command':['/bin/bash']}"]